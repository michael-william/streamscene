[Unit]
Description=StreamScene E Ink Client
Documentation=https://github.com/yourusername/streamscene
After=local-fs.target network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/streamscene-client
Environment="PATH=/home/pi/streamscene-client/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/pi/streamscene-client/venv"
Environment="STREAMSCENE_API_URL=https://streamscene.dataandstories.com"
Environment="STREAMSCENE_DISPLAY_MODE=eink"
Environment="PYTHONUNBUFFERED=1"
# DEV/TESTING ONLY: Uncomment to enable ethernet detection (production uses WiFi only)
#Environment="STREAMSCENE_ALLOW_ETHERNET=true"

# Allow binding port 80 for the captive portal without running as root.
# This replaces both the iptables 80->8080 REDIRECT (which needed an iptables
# binary that is not installed and a sudoers rule that does not exist) and the
# setcap on /usr/bin/python3 in first_boot.sh (which granted every Python
# process on the device the same privilege and was wiped by apt upgrades).
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Do NOT add CapabilityBoundingSet=CAP_NET_BIND_SERVICE here.
# It drops CAP_SETUID/CAP_SETGID for the whole service, which breaks every
# sudo call the client makes (sudo is setuid-root) - including the
# ExecStartPre below, so the unit never starts at all.

# Unblock WiFi on every boot (ensure WiFi adapter is available)
ExecStartPre=/usr/bin/sudo /usr/sbin/rfkill unblock wifi
ExecStartPre=/usr/bin/sudo /usr/sbin/rfkill unblock all

# Start the client
ExecStart=/home/pi/streamscene-client/venv/bin/python3 main.py

# Restart policy - always restart on failure
Restart=always
RestartSec=10s

# Logging - send to both journal and files
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamscene-client

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Security settings (optional - can be tightened further)
# TODO: Re-enable security hardening after refactoring network configuration setup
# The service needs to write to /etc/hostapd/, /etc/dnsmasq.d/, and /etc/wpa_supplicant/
# for WiFi hotspot and client mode configuration. ProtectSystem=strict makes /etc read-only.
# Solution: Either pre-create config templates during image build, or use specific file permissions.
# PrivateTmp=true
# ProtectSystem=strict
# ReadWritePaths=/var/log/streamscene /boot/firmware /home/pi/streamscene-client

[Install]
WantedBy=multi-user.target
