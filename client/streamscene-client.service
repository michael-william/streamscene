[Unit]
Description=StreamScene E Ink Client
Documentation=https://github.com/yourusername/streamscene
After=local-fs.target
# DO NOT wait for network - device creates hotspot if no network available

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/streamscene-client
Environment="PATH=/home/pi/streamscene-client/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/pi/streamscene-client/venv"
Environment="STREAMSCENE_API_URL=https://streamscene.dataandstories.com"
Environment="STREAMSCENE_DISPLAY_MODE=eink"
Environment="PYTHONUNBUFFERED=1"

# Start the client
ExecStart=/home/pi/streamscene-client/venv/bin/python3 main.py

# Restart policy - always restart on failure
Restart=always
RestartSec=10s
StartLimitBurst=5
StartLimitIntervalSec=60

# Logging - send to both journal and files
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamscene-client

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Security settings (optional - can be tightened further)
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/streamscene /boot/firmware /home/pi/streamscene-client

[Install]
WantedBy=multi-user.target
