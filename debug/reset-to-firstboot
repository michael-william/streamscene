#!/bin/bash
# Debug image only. Put the device back into onboarding without reflashing.
#   reset-to-firstboot          forget WiFi -> hotspot + captive portal again
#   reset-to-firstboot --full   also forget registration and re-run first boot
#                               (new UUID: the device registers as new)
# Add --no-reboot to skip the reboot. eth0 (networkd) is never touched.
set -euo pipefail
FULL=0; REBOOT=1
for a in "$@"; do
    case "$a" in
        --full) FULL=1 ;;
        --no-reboot) REBOOT=0 ;;
        *) echo "unknown option: $a" >&2; exit 2 ;;
    esac
done
[ "$EUID" -eq 0 ] || { echo "run as root" >&2; exit 1; }

C=/home/pi/streamscene-client
SAVED=/usr/local/share/streamscene-debug
BACKUP=/root/reset-backup-$(date +%Y%m%d-%H%M%S)
mkdir -p "$BACKUP"
stash() { for f in "$@"; do [ -e "$f" ] && mv -v "$f" "$BACKUP/" || true; done; }

systemctl stop streamscene-client || true
stash "$C"/wifi_credentials.json "$C"/wifi_credentials.json.failed "$C"/device_state.json
wpa_cli -i wlan0 terminate >/dev/null 2>&1 || true
ip addr flush dev wlan0 2>/dev/null || true

if [ "$FULL" -eq 1 ]; then
    stash "$C"/device_api_key.txt "$C"/.device-uuid /boot/firmware/streamscene-device.txt
    install -m 0755 -o 1000 -g 1000 "$SAVED/first_boot.sh" "$C/first_boot.sh"
    install -m 0644 "$SAVED/streamscene-firstboot.service" /etc/systemd/system/
    systemctl enable streamscene-firstboot.service
fi

echo "reset done (full=$FULL); old state saved in $BACKUP"
[ "$REBOOT" -eq 1 ] && systemctl reboot
